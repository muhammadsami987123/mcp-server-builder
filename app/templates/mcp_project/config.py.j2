"""Environment-driven configuration for the generated MCP server."""
from __future__ import annotations

import os

from pydantic import BaseModel


class Settings(BaseModel):
    api_base_url: str
{% if needs_api_key %}
    api_key: str = ""
{% endif %}
{% if needs_api_token %}
    api_token: str = ""
{% endif %}


settings = Settings(
    api_base_url=os.environ.get("API_BASE_URL", "{{ base_url }}"),
{% if needs_api_key %}
    api_key=os.environ.get("API_KEY", ""),
{% endif %}
{% if needs_api_token %}
    api_token=os.environ.get("API_TOKEN", ""),
{% endif %}
)
