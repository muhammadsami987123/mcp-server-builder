# MCP Server Builder Configuration

# OpenAI API Key (required for AI tool design)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Security thresholds
REQUEST_TIMEOUT=20
MAX_RESPONSE_SIZE=10485760
MAX_DISCOVERY_PAGES=10
MAX_REDIRECTS=5
